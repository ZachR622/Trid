{
  "name": "trid3d",
  "version": "0.2.0",
  "description": "A small 3D library for the HTML canvas: wireframes, filled and smooth faces, textures and shader effects, drawn with Canvas 2D or WebGL. No dependencies.",
  "keywords": [
    "3d",
    "canvas",
    "webgl",
    "wireframe",
    "renderer",
    "obj",
    "shader"
  ],
  "license": "MIT",
  "author": "ZachR622",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZachR622/Trid.git"
  },
  "homepage": "https://zachr622.github.io/Trid/",
  "bugs": {
    "url": "https://github.com/ZachR622/Trid/issues"
  },
  "type": "module",
  "main": "./trid/index.js",
  "module": "./trid/index.js",
  "types": "./trid/index.d.ts",
  "exports": {
    ".": {
      "types": "./trid/index.d.ts",
      "default": "./trid/index.js"
    },
    "./*": "./trid/*"
  },
  "files": [
    "trid"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
